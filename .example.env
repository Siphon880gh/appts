# Copy to .env (git-ignored, blocked from the web) and keep one block uncommented.
# Without a .env, Appts uses relative paths and works from any folder or php -S.

# Local (MAMP)
APP_ENV=local
APP_BASE_URL=http://localhost:8888/weng/app/healthcare/appts/

